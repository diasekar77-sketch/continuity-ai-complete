# --- LLM (any OpenAI-compatible provider). Leave LLM_API_KEY empty for offline heuristic mode. ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Examples (check your provider's docs for current values):
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:7b
#   Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1
# --- Embeddings run locally. 'auto' tries sentence-transformers, then a built-in hashing fallback ---
EMBEDDER=auto
DB_PATH=data/continuity.db
